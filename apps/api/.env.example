NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=change-this-secret

# Paste your Atlas connection string here (mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017/gst-suite
# false when using Atlas; auto/true for local embedded Mongo
USE_MEMORY_MONGO=auto
AUTO_SEED_DEMO=true
UPLOAD_DIR=

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fast2SMS free credit — https://www.fast2sms.com
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
SMS_PROVIDER_API_KEY=

# Razorpay — https://dashboard.razorpay.com/app/keys (test keys are free)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_MONTHLY_PAISE=99900
RAZORPAY_PLAN_YEARLY_PAISE=999900

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
WHATSAPP_ACCESS_TOKEN=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
