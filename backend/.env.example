# Copy to .env for local development. In production set these as environment
# variables on Render (see render.yaml and docs/GO_LIVE.md). With ENV=production
# the API refuses to start if JWT_SECRET, CORS_ORIGINS or MONGODB_URI are unsafe.

ENV=dev                       # dev | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                # true in production (one JSON object per line)

# MongoDB. Local: mongodb://127.0.0.1:27017/gst_expenses
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gst_expenses?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gst_expenses
MONGODB_DB=                   # empty = the database named in the URI (else gst_expenses)
MONGODB_MAX_POOL_SIZE=50

# Rate limits / short-lived cache: mongo (default, works across instances) | redis | memory
CACHE_BACKEND=mongo
REDIS_URL=

# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-in-production-32-bytes-minimum
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
PUBLIC_WEB_URL=
MAX_REQUEST_MB=40

# Rate limits
RATE_LIMIT_ENABLED=true
API_RATE_PER_MINUTE=240
LOGIN_RATE_PER_MINUTE=5
LOGIN_LOCKOUT_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15
OTP_IP_RATE_PER_HOUR=30

# One-time codes. Every code is OTP_DEV_FIXED outside production.
OTP_DEV_FIXED=123456
OTP_TTL_MINUTES=10

# Email OTP (free): brevo (300/day) | resend (100/day) | smtp | console (dev only).
# A comma-separated list is a fallback chain, e.g. brevo,resend.
EMAIL_PROVIDER=console
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=                   # a sender verified in Brevo (or on a Resend-verified domain)
EMAIL_FROM_NAME=GST Expense
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Employee login codes: auto (email when the employee has one, else SMS) | email | sms
EMPLOYEE_OTP_CHANNEL=auto
# SMS OTP (paid, optional): none | console (dev only) | msg91 | twilio
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Store-review logins: listed mobiles skip delivery and accept DEMO_OTP_CODE (6 digits)
DEMO_OTP_MOBILES=
DEMO_OTP_CODE=

# Self-service firm registration from the web console and admin app
ALLOW_SELF_SIGNUP=true
SIGNUP_VERIFY_EMAIL=true      # false = create the firm without an emailed code
SIGNUP_PLAN_CODE=starter
SIGNUP_TRIAL_DAYS=14
SIGNUP_TRIAL_SEATS=5

# Seed the Acme demo tenant (acme@demo.com) even when ENV=production
SEED_DEMO_DATA=false
ALLOW_SINGLE_INSTANCE=false

# Image storage: gridfs (inside MongoDB) | r2 (Cloudflare, 10 GB free) | local (dev only)
STORAGE_BACKEND=gridfs
STORAGE_PATH=./uploads
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=              # optional; derived from R2_ACCOUNT_ID when empty
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SIGNED_URL_SECONDS=900

# Razorpay — billing endpoints return 503 until all three are set.
# Start with rzp_test_ keys; switch to rzp_live_ after Razorpay activates your account.
# Webhook URL: https://<api-host>/v1/payments/razorpay/webhook
# Events: payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# GST on subscriptions; only charged when BUSINESS_GSTIN is set.
BILLING_TAX_PERCENT=18
BILLING_SAC_CODE=997331
BILLING_INVOICE_PREFIX=GSTX
RENEWAL_REMINDER_DAYS=7,3,1

# Your business — printed on tax invoices and the public Pricing / Contact / policy pages
BUSINESS_NAME=GST Expense
BUSINESS_LEGAL_NAME=
BUSINESS_GSTIN=
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_PHONE=

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Push notifications (free): Firebase console > Project settings > Service
# accounts > Generate new private key. Paste the JSON on one line, or base64 it.
FCM_SERVICE_ACCOUNT_JSON=

# Backups (python -m app.cli backup): S3-compatible bucket using the R2_* keys.
# Empty = archives go to ./backups. See .github/workflows/backup.yml for a free nightly job.
BACKUP_BUCKET=
BACKUP_PREFIX=backups
BACKUP_KEEP_DAYS=14

# GSTR import: files above this many rows are processed in the background
GSTR_BACKGROUND_ROWS=3000
GSTR_MAX_ROWS=200000

# Free Gemini key from https://aistudio.google.com/apikey (printed + handwritten bills)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional paid GSP (leave blank to use Excel upload only)
GSP_BASE_URL=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=

# Live GSTIN verification through a GST Suvidha Provider (the GST portal has no direct public API).
# sandbox = api.sandbox.co.in (API key + secret), appyflow = appyflow.in (key_secret),
# custom = any GSP URL containing {gstin}; the key goes in GSTIN_VERIFY_KEY_HEADER.
GSTIN_VERIFY_PROVIDER=
GSTIN_VERIFY_API_KEY=
GSTIN_VERIFY_API_SECRET=
GSTIN_VERIFY_BASE_URL=
GSTIN_VERIFY_KEY_HEADER=x-api-key
GSTIN_VERIFY_CACHE_HOURS=24
# Refuse sign-up / company GSTINs the portal reports as cancelled or unknown
GSTIN_VERIFY_ENFORCE_SIGNUP=true
