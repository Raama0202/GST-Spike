# Copy to .env for local development. In production set these as environment
# variables (see render.full-stack.yaml). With ENV=production the API refuses to start if
# JWT_SECRET, CORS_ORIGINS, R2 storage or REDIS_URL are missing/unsafe.

ENV=dev                       # dev | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                # true in production (one JSON object per line)

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gst_expenses
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=15000

# Empty = in-process store (single worker only). Required in production.
REDIS_URL=

# openssl rand -hex 32
JWT_SECRET=change-this-in-production-32-bytes-minimum
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
MAX_REQUEST_MB=40

# Rate limits
RATE_LIMIT_ENABLED=true
API_RATE_PER_MINUTE=240
LOGIN_RATE_PER_MINUTE=5
LOGIN_LOCKOUT_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15
OTP_IP_RATE_PER_HOUR=30

# OTP delivery: console (dev only, logs the code) | msg91 | twilio
SMS_PROVIDER=console
OTP_DEV_FIXED=123456          # ignored when ENV=production
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Demo / store-review logins: listed mobiles skip SMS and accept DEMO_OTP_CODE (6 digits)
DEMO_OTP_MOBILES=
DEMO_OTP_CODE=
# Seed the Acme demo tenant (acme@demo.com) even when ENV=production
SEED_DEMO_DATA=false
# One instance without Redis/R2 (local uploads are lost on redeploy)
ALLOW_SINGLE_INSTANCE=false

# Image storage: local | r2
STORAGE_BACKEND=local
STORAGE_PATH=./uploads
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=              # optional; derived from R2_ACCOUNT_ID when empty
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SIGNED_URL_SECONDS=900

# Razorpay — billing endpoints return 503 until all three are set
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BILLING_TAX_PERCENT=18

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# GSTR import: files above this many rows are processed in the background
GSTR_BACKGROUND_ROWS=3000
GSTR_MAX_ROWS=200000

# Free Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional paid GSP (leave blank to use Excel upload only)
GSP_BASE_URL=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=

# Optional SMTP for outbound email reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
